# RouteGate MVP deployment environment example
# Copy to .env for local shell use and replace every placeholder before using a non-dev deployment.
# Do not commit real secrets.

# Manager / backend
ROUTEGATE_ENV=dev
ROUTEGATE_HTTP_ADDR=:8080
# Canonical external HTTPS origin used for server-side onboarding links.
ROUTEGATE_PUBLIC_URL=https://routegate.example.com
ROUTEGATE_DATABASE_URL=postgres://routegate:routegate_dev_password@localhost:5432/routegate?sslmode=disable
ROUTEGATE_LOG_LEVEL=info
ROUTEGATE_AUTH_SESSION_TTL_HOURS=24

# Email delivery / SMTP
# Keep credentials out of source control. Production-like installs use the root-only Manager environment file.
ROUTEGATE_SMTP_HOST=smtp.example.com
ROUTEGATE_SMTP_PORT=587
ROUTEGATE_SMTP_USERNAME=replace-with-smtp-user
ROUTEGATE_SMTP_PASSWORD=replace-with-smtp-password
ROUTEGATE_SMTP_FROM_ADDRESS=routegate@example.com
ROUTEGATE_SMTP_FROM_NAME=RouteGate
# Supported values: starttls or tls. Plaintext SMTP is intentionally unsupported.
ROUTEGATE_SMTP_TLS_MODE=starttls

# Telegram delivery / official Bot API
# The bot can send to a private user only after the user has started or messaged the bot.
ROUTEGATE_TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# WhatsApp Business delivery / official Meta Cloud API
# Create and approve both templates in WhatsApp Manager first.
# Each template must contain one body text parameter: {{1}} = secure RouteGate access link.
ROUTEGATE_WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
ROUTEGATE_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
# Set an explicitly supported Graph API version in vX.Y form; do not rely on an implicit "latest".
ROUTEGATE_WHATSAPP_GRAPH_API_VERSION=REPLACE_WITH_SUPPORTED_GRAPH_API_VERSION
ROUTEGATE_WHATSAPP_TEMPLATE_VPN_ACCESS=routegate_vpn_access
ROUTEGATE_WHATSAPP_TEMPLATE_VPN_ACCESS_REISSUED=routegate_vpn_access_reissued
ROUTEGATE_WHATSAPP_LANGUAGE_EN=en_US
ROUTEGATE_WHATSAPP_LANGUAGE_RU=ru

# Initial admin bootstrap
# Development defaults are convenient for local testing only.
# Use a unique email/username/password before any shared, public, or production-like deployment.
ROUTEGATE_BOOTSTRAP_ADMIN_EMAIL=admin@routegate.local
ROUTEGATE_BOOTSTRAP_ADMIN_USERNAME=admin
ROUTEGATE_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-deploy
ROUTEGATE_BOOTSTRAP_ADMIN_DISPLAY_NAME=RouteGate Admin

# PostgreSQL values used by the current development Docker Compose stack.
# Keep these aligned with ROUTEGATE_DATABASE_URL when changing the database credentials.
POSTGRES_DB=routegate
POSTGRES_USER=routegate
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Agent
# The agent normally uses /etc/routegate/agent.yaml.
# These values are useful for local scripts, examples, or future packaging work.
ROUTEGATE_AGENT_MANAGER_URL=http://localhost:8080
ROUTEGATE_AGENT_REGISTRATION_TOKEN=replace-with-registration-token
ROUTEGATE_AGENT_ID=local-dev-agent
ROUTEGATE_AGENT_SERVER_ID=replace-after-registration
ROUTEGATE_AGENT_TOKEN=replace-after-registration
ROUTEGATE_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
ROUTEGATE_AGENT_CONFIG_STAGING_DIR=/var/lib/routegate-agent/configs
ROUTEGATE_AGENT_ACTIVE_CONFIG_PATH=/etc/sing-box/config.json
ROUTEGATE_AGENT_CONFIG_BACKUP_DIR=/var/lib/routegate-agent/backups
ROUTEGATE_AGENT_SING_BOX_PATH=sing-box
ROUTEGATE_AGENT_SING_BOX_SERVICE_NAME=sing-box
ROUTEGATE_AGENT_TRAFFIC_COLLECTION_ENABLED=false
ROUTEGATE_AGENT_TRAFFIC_COLLECTION_INTERVAL_SECONDS=60
ROUTEGATE_AGENT_TRAFFIC_USAGE_FILE_PATH=/var/lib/routegate-agent/traffic-usage.json
