[Unit]
Description=RouteGate Agent
Documentation=https://github.com/ikaevus/RouteGate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/routegate-agent -config /etc/routegate/agent.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=multi-user.target
