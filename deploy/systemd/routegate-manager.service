[Unit]
Description=RouteGate Manager
Documentation=https://github.com/ikaevus/RouteGate
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=routegate
Group=routegate
WorkingDirectory=/opt/routegate-manager
EnvironmentFile=/etc/routegate/manager.env
ExecStart=/usr/local/bin/routegate-manager
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
