[Unit]
Description=RouteGate detached VPN update transaction for task %i
Documentation=https://github.com/ikaevus/RouteGate
After=network-online.target
Wants=network-online.target
Conflicts=shutdown.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/lib/routegate/update/routegate-vpn-update-worker.sh %i
TimeoutStartSec=30min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
