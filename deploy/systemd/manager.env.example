# RouteGate Manager production-like environment example.
# Install as /etc/routegate/manager.env with owner root:root and mode 0600.

ROUTEGATE_ENV=production
ROUTEGATE_HTTP_ADDR=127.0.0.1:8080
ROUTEGATE_PUBLIC_URL=https://routegate.example.com
ROUTEGATE_DATABASE_URL=postgres://routegate:REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD@127.0.0.1:5432/routegate?sslmode=disable
ROUTEGATE_LOG_LEVEL=info
ROUTEGATE_AUTH_SESSION_TTL_HOURS=24

# Email delivery / SMTP.
# Managed Delivery settings in the Admin Web UI are the primary configuration path.
# These environment values remain available for bootstrap / compatibility only.
ROUTEGATE_SMTP_HOST=smtp.example.com
ROUTEGATE_SMTP_PORT=587
ROUTEGATE_SMTP_USERNAME=REPLACE_WITH_SMTP_USER
ROUTEGATE_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
ROUTEGATE_SMTP_FROM_ADDRESS=routegate@example.com
ROUTEGATE_SMTP_FROM_NAME=RouteGate
# Supported values: starttls or tls. Plaintext SMTP is intentionally unsupported.
ROUTEGATE_SMTP_TLS_MODE=starttls

# Telegram delivery / official Bot API.
# Managed Delivery settings in the Admin Web UI are the primary configuration path.
# A private recipient must start/message the bot before the bot can send access to that chat.
ROUTEGATE_TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# Temporary first-start bootstrap only.
# Replace all values before starting Manager on a public host.
# After the first SuperAdmin is created, remove or blank the password and
# restart Manager. The future first-run setup flow will replace this mechanism.
ROUTEGATE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ROUTEGATE_BOOTSTRAP_ADMIN_USERNAME=admin
ROUTEGATE_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_TEMPORARY_PASSWORD
ROUTEGATE_BOOTSTRAP_ADMIN_DISPLAY_NAME=RouteGate Administrator
